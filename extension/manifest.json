{
  "manifest_version": 3,
  "name": "Showrun Recorder",
  "version": "0.1.0",
  "description": "Record one browser task (clicks, typing, screenshots, voice) so Showrun can learn it.",
  "permissions": ["offscreen", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Showrun Recorder" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
